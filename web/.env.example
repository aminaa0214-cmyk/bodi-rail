# Маягтаас ирсэн хүсэлтийг и-мэйлээр илгээх (https://resend.com)
# Vercel дээр: Project → Settings → Environment Variables хэсэгт нэмнэ.
RESEND_API_KEY=

# Хүсэлт хүлээн авах хаяг
CONTACT_TO_EMAIL=info@bodirail.mn

# Онлайн анкет хүлээн авах хаяг. Хоосон бол CONTACT_TO_EMAIL руу илгээнэ.
HR_TO_EMAIL=

# Илгээгчийн хаяг. bodirail.mn домэйнийг Resend дээр баталгаажуулсны дараа ашиглана.
# Баталгаажуулаагүй үед "onboarding@resend.dev" нь зөвхөн Resend бүртгэлийн и-мэйл рүү илгээдэг.
CONTACT_FROM_EMAIL="Бодь Рэйл вэбсайт <noreply@bodirail.mn>"

# Supabase (https://supabase.com/dashboard → Project Settings → API Keys).
# Ажлын зар, мэдээ, бүтээгдэхүүн/үйлчилгээний картуудыг уншиж, ирсэн анкетыг хадгална.
# Publishable key нь нууц биш: RLS-ээр зөвхөн нийтийн агуулгыг унших, анкет нэмэхийг зөвшөөрсөн.
SUPABASE_URL=https://qmcjfkimrqqmsnsnndzx.supabase.co
